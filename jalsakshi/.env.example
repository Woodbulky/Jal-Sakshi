# ---------------------------------------------------------------------------
# JAL-SAKSHI environment reference
#
# The database is Supabase and only Supabase. There is no local database and
# no SQLite fallback. Schema and seed data are applied to the `jal-sakshi`
# Supabase project through the Supabase MCP server. Tests run offline against
# in-memory repository fakes and never touch a database.
# ---------------------------------------------------------------------------

APP_ENV=local                 # local | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json  (use json in production)

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=                 # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=            # browser-safe key
SUPABASE_SERVICE_ROLE_KEY=    # server-only, never expose to the frontend

# --- API ------------------------------------------------------------------
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Demo / simulator -----------------------------------------------------
DEMO_SERVICE_AREA_ID=demo-vitpur
SIMULATION_TICK_SECONDS=10     # wall-clock seconds between live samples
SIMULATION_TIME_SCALE=30       # hydraulic integration speed-up; timestamps stay real

# --- Detection ------------------------------------------------------------
# The baseline is the learned diurnal day-shape (median + MAD per time-of-day
# bucket). The newest slice is excluded from learning so a fault developing
# right now cannot redefine "normal".
DETECTION_BASELINE_HOURS=48
DETECTION_BASELINE_REFRESH_SECONDS=900
DETECTION_BASELINE_EXCLUDE_RECENT_MINUTES=45
DETECTION_WINDOW_MINUTES=15
DETECTION_Z_THRESHOLD=3.5
DETECTION_MIN_CONFIDENCE=0.55   # below this the classifier must answer UNKNOWN
DETECTION_AUTORUN=true          # run detection after every simulator tick

# Optional trained booster. Blank = the signature rules run alone, which is
# what the demo ships with.
LIGHTGBM_MODEL_PATH=
LIGHTGBM_BLEND_WEIGHT=0.5

# --- Agent / LLM (Phase 3) ------------------------------------------------
# The LLM is a controlled reasoning component only. It never executes SQL and
# never authorises a state transition.
LLM_PROVIDER=groq             # none | groq | anthropic | google | openai
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=                  # leave blank to use the deterministic stub
LLM_BASE_URL=https://api.groq.com/openai/v1   # blank = provider default

# --- Work orders and verification (Phase 4) -------------------------------
# Telemetry must read normal for this long after a reported repair before
# restoration is confirmed. Short enough for a live demo, long enough that one
# lucky sample cannot close an incident.
VERIFICATION_WINDOW_MINUTES=20

# Failures at one asset inside the review window before the agent stops writing
# repair tickets and recommends a design or procedural review instead.
ASSET_RECURRENCE_THRESHOLD=3
ASSET_RECURRENCE_WINDOW_DAYS=30

# --- n8n / Telegram (Phase 5) --------------------------------------------
# Blank N8N_WEBHOOK_URL does not disable messaging: every message is still
# composed and stored in `notifications` with status SKIPPED, so the console
# shows exactly what a field actor would have received. Only delivery stops.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=           # signs the outbound body (X-JalSakshi-Signature)
N8N_TIMEOUT_SECONDS=10

# Presented by n8n on inbound callbacks, as X-JalSakshi-Callback-Secret or as
# an HMAC signature over the body. Blank refuses every callback: the route can
# move a work order, so it does not fall back to being open.
INBOUND_CALLBACK_SECRET=

# Where this deployment is reachable, so outbound payloads can tell n8n which
# URL to send the field actor's reply back to.
PUBLIC_BASE_URL=              # e.g. https://jal-sakshi-api.onrender.com

# --- Realtime (Phase 5) ---------------------------------------------------
# Server-Sent Events at GET /api/v1/events/stream. In-process, single worker.
REALTIME_HISTORY=200          # events kept for a console that reconnects
REALTIME_QUEUE_SIZE=100       # per client; a slow console drops, never blocks
REALTIME_HEARTBEAT_SECONDS=15
